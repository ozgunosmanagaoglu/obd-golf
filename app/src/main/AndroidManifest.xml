<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Old Bluetooth permissions. Officially only for Android 11 and older, but some
         Xiaomi (MIUI/HyperOS) builds still check BLUETOOTH on Android 12+ when opening a
         socket ("lacks permission android.permission.BLUETOOTH"), so no maxSdkVersion.
         Both are install-time permissions: no dialog is shown. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Android 12+: connect to paired devices. SCAN is needed because connecting
         stops any running discovery first (cancelDiscovery); we never use it for location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Scanning for Bluetooth LE adapters on Android 11 and older needs location access
         (Android's rule, the app does not use location). Android 12+ uses BLUETOOTH_SCAN instead. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Wi-Fi OBD adapters: a TCP socket on the adapter's own Wi-Fi network (no internet there),
         so the app asks Android for that network explicitly. All are normal permissions (no dialog). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Stay connected with the screen off or another app in front: a foreground service of type
         connectedDevice (Android 14+ needs the typed permission; CHANGE_NETWORK_STATE above satisfies
         its runtime prerequisite) and a partial wake lock while an adapter is connected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: lets the "Connected" notification show. Asked once; the app works without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ObdGolf"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
