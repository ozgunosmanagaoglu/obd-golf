<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system splash first: keep it dark with the red icon,
         so it flows straight into the app's own loading screen. -->
    <style name="Theme.ObdGolf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/accent</item>
    </style>
</resources>
